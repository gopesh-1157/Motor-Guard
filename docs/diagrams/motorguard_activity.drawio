        <mxCell id="act_e_phys" value="Deterministic Physical Safety Rules:
• Hard Overcurrent (&gt;= 4.5A CRITICAL)
• Overcurrent (&gt;= 4.0A CRIT / &gt;= 3.4A WARN)
• Overtemp (&gt;= 75°C CRIT / &gt;= 50°C WARN)
• Vibration RMS (&gt;= 0.4g CRIT / &gt;= 0.1g WARN)
• Vibration Peak (&gt;= 0.8g CRIT / &gt;= 0.35g WARN)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#F8FAFC;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;shadow=0;" parent="1" vertex="1">
          <mxGeometry x="1675" y="2740" width="230" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="act_e_ml" value="Edge Impulse TinyML Evaluation:
• Confidence thresholding (&gt;= 50%)
• ML Classes: healthy, warning, critical
• Model diagnostic error detection" style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.8;fontColor=#1E3A8A;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;fontStyle=1;shadow=0;" parent="1" vertex="1">
          <mxGeometry x="1675" y="2850" width="230" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="act_e_diag" value="Sensor Availability Checks:
• Temperature DISCONNECTED/OUT_OF_RANGE
• Current sensor DISCONNECTED/UNAVAILABLE
• Accelerometer I2C bus failure
• Zero-calibration UNCALIBRATED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#F8FAFC;strokeColor=#1E293B;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;shadow=0;" parent="1" vertex="1">
