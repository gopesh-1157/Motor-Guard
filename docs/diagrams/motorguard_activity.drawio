        </mxCell>
        <mxCell id="note_c_zero" value="STRICT ZERO vs. UNAVAILABLE:
Missing readings produce null.
De-energized idle motor produces 0.0A.
Prevents distortion of fleet metrics." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=6;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=1.2;fontColor=#713F12;fontSize=9;fontFamily=Helvetica;" parent="1" vertex="1">
