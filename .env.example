# ==============================================================================
# MotorGuard — Environment Configuration Template
# Copy this file to '.env' and adjust values for your local environment.
# Never commit active credentials, production passwords, or '.env' to Git.
# ==============================================================================

# --- Application Runtime & Security ---
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Gateway Network Binding ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Local MongoDB Storage ---
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=motorguard_db
TELEMETRY_RETENTION_DAYS=90

# --- Eclipse Mosquitto / Cloud MQTT Broker ---
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_USERNAME=motorguard_gateway
MQTT_PASSWORD=replace_with_broker_password_in_production
MQTT_CLIENT_ID=motorguard-fastapi-backend
MQTT_KEEPALIVE_SEC=60

# --- Global Cloud MQTT / MQTTS TLS Configuration ---
# Set to 'true' when connecting to Cloud Brokers on port 8883 (e.g. HiveMQ, EMQX)
MQTT_USE_TLS=false
# Optional path to custom CA certificate bundle (uses system root CA / Let's Encrypt by default)
# MQTT_TLS_CA_CERT=/path/to/ca.crt
# Skip hostname verification (TESTING ONLY; strictly rejected in production)
MQTT_TLS_INSECURE=false
# Transport protocol: 'tcp' or 'websockets'
MQTT_TRANSPORT=tcp

# --- Device Liveness & Safety Rule Thresholds ---
DEVICE_STALE_TIMEOUT_SEC=15
DEVICE_OFFLINE_TIMEOUT_SEC=35
DEFAULT_OVERCURRENT_LIMIT_A=4.0
DEFAULT_MAX_TEMP_C=50.0

# --- Frontend Client Configuration ---
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000/ws

# --- Virtual Motor Simulator ---
SIM_BROKER_HOST=127.0.0.1
SIM_BROKER_PORT=1883
SIM_DEVICE_ID=sim-node-001
SIM_MOTOR_ID=mtr-775-sim
SIM_INTERVAL_MS=1000
