// ==============================================================================
// MotorGuard — ESP32 Firmware Cloud Credentials & TLS Security Configuration
// INSTRUCTIONS:
// 1. Copy this file to "secrets.h" in the same directory:
//    cp secrets.h.example secrets.h
// 2. Fill in your real plant Wi-Fi credentials and Cloud MQTT Broker credentials.
// 3. "secrets.h" is ignored by git (.gitignore) to prevent credential leakage.
// ==============================================================================

#ifndef MOTORGUARD_SECRETS_H
#define MOTORGUARD_SECRETS_H

// --- 1. Operation Mode ---
// Set to 1 to connect to Global Cloud Broker over MQTTS TLS (Port 8883)
// Set to 0 for local standalone SoftAP mode (192.168.4.2:1883)
#define USE_CLOUD_MQTT 1

// --- 2. Plant / Factory Wi-Fi Station Credentials ---
// (Required when USE_CLOUD_MQTT is 1 to connect to the Internet)
#define STA_WIFI_SSID     "Your-Factory-WiFi-SSID"
#define STA_WIFI_PASSWORD "Your-Factory-WiFi-Password"

// --- 3. Global Cloud MQTT Broker (MQTTS Port 8883) ---
// Example HiveMQ Cloud: "your-cluster-id.s1.eu.hivemq.cloud"
// Example EMQX Serverless: "broker.emqx.io" or your custom domain
#define CLOUD_MQTT_BROKER "your-cluster-id.s1.eu.hivemq.cloud"
#define CLOUD_MQTT_PORT   8883

// --- 4. Hardware Node Identity & Scoped Credentials ---
// Each hardware node MUST have its own independent credentials and topic-scoped ACL.
// Hardware nodes should NOT use the shared gateway or simulator passwords.
#define CLOUD_DEVICE_ID   "ESP32-NODE-001"
#define CLOUD_MQTT_USER   "esp32_node_001"
#define CLOUD_MQTT_PASS   "SuperSecureDevicePassword123!"

// --- 5. Trusted Root CA Certificate (ISRG Root X1) ---
// Used by Let's Encrypt, HiveMQ Cloud, and EMQX Cloud.
// Valid through: June 4, 2035.
// DO NOT use setInsecure() in production — this certificate verifies the broker.
